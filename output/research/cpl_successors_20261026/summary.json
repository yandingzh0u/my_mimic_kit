  "request": "CPL follow-up research, application-specific candidates and stress tests; no new loss coefficients",
  "sources": [
    {
      "title": "A Unified Algebraic Perspective on Lipschitz Neural Networks",
      "year": 2023,
      "url": "https://arxiv.org/html/2303.03169v2",
      "role": "Direct CPL extension SLL; use corrected exponential diagonal scaling without extra spectral normalization in its blocks"
    },
    {
      "title": "Direct Parameterization of Lipschitz-Bounded Deep Networks",
      "year": 2023,
      "url": "https://proceedings.mlr.press/v202/wang23v.html",
      "role": "Sandwich parameterization; test a matching matrix-budget version with half-width hidden nonlinearities; omit redundant ReLU diagonal rescaling"
    },
    {
      "title": "1-Lipschitz Layers Compared: Memory, Speed, and Certifiable Robustness",
      "year": 2023,
      "url": "https://arxiv.org/abs/2311.16833",
      "role": "Independent comparison documents CPL initialization sensitivity and method-dependent resource/optimization tradeoffs"
    },
    {
      "title": "LipNeXt: Scaling up Lipschitz-based Certified Robustness to Billion-parameter Models",
      "year": 2026,
      "url": "https://arxiv.org/abs/2601.18513",
      "role": "Motivates orthogonal trainable maps. Borrow the orthogonality principle, not its image shifts, beta fraction, FastExp thresholds or Lookahead hyperparameters. Our Cayley-SGD probe is not an implementation of the full LipNeXt algorithm."
    }
