#usda 1.0
# Board geometry, inertia, and steering coupling from HUSKY (Han et al., RSS 2026, CC BY-NC 4.0).
# https://github.com/TeleHuman/humanoid_skateboarding/blob/main/test_scene/mjlab_scene.xml
(
    defaultPrim = "Skateboard"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)
def Xform "Skateboard" (prepend apiSchemas = ["PhysicsArticulationRootAPI"]) {
    def Xform "skateboard_deck" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]) {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 1.5
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.005, 0.08, 0.085)
        quatf physics:principalAxes = (1, 0, 0, 0)
    }
    def Xform "board_tilt_body" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]) {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 3.65
        point3f physics:centerOfMass = (-0.0246575342, 0, 0.000616438356)
        float3 physics:diagonalInertia = (0.201333726, 0.189942768, 0.0116298759)
        quatf physics:principalAxes = (0, 0.707841674, 0, 0.706371124)
        def Cube "skateboard_deck_collision" (prepend apiSchemas = ["PhysicsCollisionAPI"]) {
            color3f[] primvars:displayColor = [(0.74, 0.36, 0.18)]
            double3 xformOp:translate = (0, 0, 0)
            quatd xformOp:orient = (1, 0, 0, 0)
            double size = 1
            double3 xformOp:scale = (0.8, 0.2, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
        def Cube "skateboard_marker_collision" (prepend apiSchemas = ["PhysicsCollisionAPI"]) {
            color3f[] primvars:displayColor = [(0.83, 0.51, 0.2)]
            double3 xformOp:translate = (-0.2, 0, 0.005)
            quatd xformOp:orient = (1, 0, 0, 0)
            double size = 1
            double3 xformOp:scale = (0.3, 0.15, 0.01)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }
    def Xform "front_truck" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]) {
        double3 xformOp:translate = (0.2, 0, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.5
        point3f physics:centerOfMass = (0, 0, -0.09)
        float3 physics:diagonalInertia = (0.00043, 3.3e-05, 0.00043)
        quatf physics:principalAxes = (0.707388225, 0, 0, 0.706825225)
        def Cube "front_truck_collision" (prepend apiSchemas = ["PhysicsCollisionAPI"]) {
            color3f[] primvars:displayColor = [(0.23, 0.26, 0.3)]
            double3 xformOp:translate = (0, 0, -0.09)
            quatd xformOp:orient = (0.707388225, 0, 0, 0.706825225)
            double size = 1
            double3 xformOp:scale = (0.1, 0.02, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }
    def Xform "front_left_wheel" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]) {
        double3 xformOp:translate = (0.2, 0, -0.07)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.2
        point3f physics:centerOfMass = (0, 0.07, 0)
        float3 physics:diagonalInertia = (1e-05, 1e-05, 1e-05)
        quatf physics:principalAxes = (1, 0, 0, 0)
        def Cylinder "front_left_wheel_collision" (prepend apiSchemas = ["PhysicsCollisionAPI"]) {
            color3f[] primvars:displayColor = [(0.23, 0.26, 0.3)]
            double3 xformOp:translate = (0, 0.07, 0)
            quatd xformOp:orient = (0.707388225, 0.706825225, 0, 0)
            double radius = 0.03
            double height = 0.04
            uniform token axis = "Z"
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }
    def Xform "front_right_wheel" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]) {
        double3 xformOp:translate = (0.2, 0, -0.07)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.2
        point3f physics:centerOfMass = (0, -0.07, 0)
        float3 physics:diagonalInertia = (1e-05, 1e-05, 1e-05)
        quatf physics:principalAxes = (1, 0, 0, 0)
        def Cylinder "front_right_wheel_collision" (prepend apiSchemas = ["PhysicsCollisionAPI"]) {
            color3f[] primvars:displayColor = [(0.23, 0.26, 0.3)]
            double3 xformOp:translate = (0, -0.07, 0)
            quatd xformOp:orient = (0.707388225, 0.706825225, 0, 0)
            double radius = 0.03
            double height = 0.04
            uniform token axis = "Z"
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }
    def Xform "rear_truck" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]) {
        double3 xformOp:translate = (-0.2, 0, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.5
        point3f physics:centerOfMass = (0, 0, -0.09)
        float3 physics:diagonalInertia = (0.00043, 3.3e-05, 0.00043)
        quatf physics:principalAxes = (0.707388225, 0, 0, 0.706825225)
        def Cube "rear_truck_collision" (prepend apiSchemas = ["PhysicsCollisionAPI"]) {
            color3f[] primvars:displayColor = [(0.23, 0.26, 0.3)]
            double3 xformOp:translate = (0, 0, -0.09)
            quatd xformOp:orient = (0.707388225, 0, 0, 0.706825225)
            double size = 1
            double3 xformOp:scale = (0.1, 0.02, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }
    def Xform "rear_left_wheel" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]) {
        double3 xformOp:translate = (-0.2, 0, -0.07)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.2
        point3f physics:centerOfMass = (0, 0.07, 0)
        float3 physics:diagonalInertia = (1e-05, 1e-05, 1e-05)
        quatf physics:principalAxes = (1, 0, 0, 0)
        def Cylinder "rear_left_wheel_collision" (prepend apiSchemas = ["PhysicsCollisionAPI"]) {
            color3f[] primvars:displayColor = [(0.23, 0.26, 0.3)]
            double3 xformOp:translate = (0, 0.07, 0)
            quatd xformOp:orient = (0.707388225, 0.706825225, 0, 0)
            double radius = 0.03
            double height = 0.04
            uniform token axis = "Z"
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }
    def Xform "rear_right_wheel" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]) {
        double3 xformOp:translate = (-0.2, 0, -0.07)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.2
        point3f physics:centerOfMass = (0, -0.07, 0)
        float3 physics:diagonalInertia = (1e-05, 1e-05, 1e-05)
        quatf physics:principalAxes = (1, 0, 0, 0)
        def Cylinder "rear_right_wheel_collision" (prepend apiSchemas = ["PhysicsCollisionAPI"]) {
            color3f[] primvars:displayColor = [(0.23, 0.26, 0.3)]
            double3 xformOp:translate = (0, -0.07, 0)
            quatd xformOp:orient = (0.707388225, 0.706825225, 0, 0)
            double radius = 0.03
            double height = 0.04
            uniform token axis = "Z"
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }
    def Scope "Joints" {
        def PhysicsRevoluteJoint "board_tilt_joint" (prepend apiSchemas = ["PhysicsDriveAPI:angular"]) {
            uniform token physics:axis = "X"
            rel physics:body0 = </Skateboard/skateboard_deck>
            rel physics:body1 = </Skateboard/board_tilt_body>
            point3f physics:localPos0 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0, 1, 0)
            quatf physics:localRot1 = (0, 0, 1, 0)
            float physics:lowerLimit = -11.459156
            float physics:upperLimit = 11.459156
            float drive:angular:physics:stiffness = 0.2560398
            float drive:angular:physics:damping = 0.0070162236
        }
        def PhysicsRevoluteJoint "front_truck_roll_joint" (prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxMimicJointAPI:rotZ"]) {
            uniform token physics:axis = "Z"
            rel physics:body0 = </Skateboard/skateboard_deck>
            rel physics:body1 = </Skateboard/front_truck>
            point3f physics:localPos0 = (0.2, 0, 0.02)
            quatf physics:localRot0 = (0, 1, 0, 0)
            quatf physics:localRot1 = (0, 1, 0, 0)
            float physics:lowerLimit = -5.729578
            float physics:upperLimit = 5.729578
            float drive:angular:physics:stiffness = 0.17453293
            float drive:angular:physics:damping = 0.0087266463
            float drive:angular:physics:maxForce = 20
            rel physxMimicJoint:rotZ:referenceJoint = </Skateboard/Joints/board_tilt_joint>
            uniform token physxMimicJoint:rotZ:referenceJointAxis = "rotX"
            float physxMimicJoint:rotZ:gearing = 0.577
        }
        def PhysicsRevoluteJoint "front_left_wheel_joint" {
            uniform token physics:axis = "Y"
            rel physics:body0 = </Skateboard/front_truck>
            rel physics:body1 = </Skateboard/front_left_wheel>
            point3f physics:localPos0 = (0, 0, -0.09)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
        def PhysicsRevoluteJoint "front_right_wheel_joint" {
            uniform token physics:axis = "Y"
            rel physics:body0 = </Skateboard/front_truck>
            rel physics:body1 = </Skateboard/front_right_wheel>
            point3f physics:localPos0 = (0, 0, -0.09)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
        def PhysicsRevoluteJoint "rear_truck_roll_joint" (prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxMimicJointAPI:rotZ"]) {
            uniform token physics:axis = "Z"
            rel physics:body0 = </Skateboard/skateboard_deck>
            rel physics:body1 = </Skateboard/rear_truck>
            point3f physics:localPos0 = (-0.2, 0, 0.02)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -5.729578
            float physics:upperLimit = 5.729578
            float drive:angular:physics:stiffness = 0.17453293
            float drive:angular:physics:damping = 0.0087266463
            float drive:angular:physics:maxForce = 20
            rel physxMimicJoint:rotZ:referenceJoint = </Skateboard/Joints/board_tilt_joint>
            uniform token physxMimicJoint:rotZ:referenceJointAxis = "rotX"
            float physxMimicJoint:rotZ:gearing = 0.577
        }
        def PhysicsRevoluteJoint "rear_left_wheel_joint" {
            uniform token physics:axis = "Y"
            rel physics:body0 = </Skateboard/rear_truck>
            rel physics:body1 = </Skateboard/rear_left_wheel>
            point3f physics:localPos0 = (0, 0, -0.09)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
        def PhysicsRevoluteJoint "rear_right_wheel_joint" {
            uniform token physics:axis = "Y"
            rel physics:body0 = </Skateboard/rear_truck>
            rel physics:body1 = </Skateboard/rear_right_wheel>
            point3f physics:localPos0 = (0, 0, -0.09)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}
